<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <runtime>
    <!--
      Allow the .NET Framework to load the bundled managed assemblies (pythonnet's
      Python.Runtime.dll and the WebView2 assemblies) even when Windows has tagged
      them with Mark-of-the-Web after the user downloaded and extracted the .zip.
      Without this, loading a "remote-zone" assembly raises NotSupportedException
      ("An attempt was made to load an assembly from a network location...").
      The launcher also strips the mark at startup; this config is the fallback
      for read-only install locations where stripping cannot run.
    -->
    <loadFromRemoteSources enabled="true" />
  </runtime>
</configuration>
